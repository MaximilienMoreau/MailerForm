{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/press",
      "destination": "/press/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies/index.html"
    },
    {
      "source": "/gdpr",
      "destination": "/gdpr/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/transactional-reputation",
      "destination": "/blog/transactional-reputation/index.html"
    },
    {
      "source": "/blog/authentication-alignment",
      "destination": "/blog/authentication-alignment/index.html"
    },
    {
      "source": "/blog/content-and-reputation",
      "destination": "/blog/content-and-reputation/index.html"
    },
    {
      "source": "/blog/stream-isolation",
      "destination": "/blog/stream-isolation/index.html"
    },
    {
      "source": "/blog/email-data-controls",
      "destination": "/blog/email-data-controls/index.html"
    },
    {
      "source": "/blog/migration-playbook",
      "destination": "/blog/migration-playbook/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
